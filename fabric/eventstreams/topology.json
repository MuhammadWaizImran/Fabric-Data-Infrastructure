    {"name": "IoT Hub", "binding": "IOTHUB_CONNECTION_ID", "mode": "tenant-authoring"},
    {"name": "AWS Kinesis", "binding": "KINESIS_CONNECTION_ID", "mode": "tenant-authoring"},
